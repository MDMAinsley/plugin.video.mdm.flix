<?xml version='1.0' encoding='utf-8'?>
<settings>
  <category label="General">
    <setting id="scraper_provider" type="select" label="Scraper Provider" values="Auto|MDM Link|CocoScrapers" default="Auto" />
    <setting id="playback_mode" type="select" label="Playback Mode" values="Source Select|Autoplay" default="Source Select" />
    <setting id="autoplay_attempts" type="select" label="Autoplay maximum sources" values="1|2|3" default="3" />
    <setting id="last_autoplay_summary" type="text" label="Legacy Autoplay summary (unused)" default="" visible="false" />
  </category>
  <category label="TMDB">
    <setting id="tmdb_token" type="text" option="hidden" label="TMDB API Read Access Token (preferred)" default="" />
    <setting id="tmdb_api_key" type="text" option="hidden" label="TMDB API Key (alternative)" default="" />
    <setting id="tmdb_language" type="text" label="Metadata language (e.g. en-GB)" default="en-GB" />
  </category>
  <category label="AllDebrid">
    <setting id="alldebrid_enabled" type="bool" label="Enable AllDebrid (prioritised when enabled)" default="true" />
    <setting id="alldebrid_api_key" type="text" option="hidden" label="AllDebrid API key (or authorise through Tools)" default="" />
  </category>
  <category label="Device tuning">
    <setting id="device_quality_max" type="select" label="Maximum reported quality" default="Unlimited" values="Unlimited|720p|1080p|4K" />
    <setting id="device_unknown_quality" type="select" label="Unknown source quality" default="Show" values="Show|Hide" />
    <setting id="device_workers" type="integer" label="Provider workers" default="6" />
    <setting id="device_search_timeout" type="integer" label="Search budget (10-120 seconds)" default="45" />
    <setting id="device_request_timeout" type="integer" label="Request timeout (10-60 seconds)" default="15" />
    <setting id="device_artwork" type="select" label="Catalogue artwork" default="Standard" values="Standard|Light" />
  </category>
  <category label="Connection / file size">
    <setting id="device_connection_mbps" type="text" label="Connection speed Mbps (0 = off; max 10000)" default="0" />
    <setting id="device_max_size_gib" type="text" label="Maximum reported size GiB (0 = unlimited; max 10000)" default="0" />
    <setting id="device_source_order" type="select" label="Source order" default="Quality" values="Quality|Connection|Smallest" />
    <setting id="device_unknown_size" type="select" label="Unknown size when size limit is active" default="Show" values="Show|Hide" />
    <setting id="device_slow_sources" type="select" label="Above estimated connection budget" default="Show" values="Show|Hide" />
    <setting id="device_unknown_bitrate" type="select" label="Unknown bitrate when connection is active" default="Show" values="Show|Hide" />
  </category>
</settings>